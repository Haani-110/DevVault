generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  passwordHash      String?
  avatarUrl         String?
  bio               String?
  location          String?
  website           String?
  githubUrl         String?
  linkedinUrl       String?
  role              Role      @default(DEVELOPER)
  // Access/refresh tokens issued before this moment are rejected (see
  // JwtStrategy), so changing or resetting a password actually signs the user
  // out everywhere instead of leaving old sessions valid until they expire.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  notes             Note[]
  oauthAccounts     OAuthAccount[]
  passwordResets    PasswordReset[]
  projects          Project[]
  snippets          Snippet[]
  tasks             Task[]
  importJobs        ImportJob[]
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  title      String
  content    String
  tags       String[]
  isPinned   Boolean  @default(false)
  isFavorite Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Provenance ────────────────────────────────────────────────────────────
  // Marks content the AI GitHub import generated and where it came from, so
  // the UI can say "Generated by AI · src/auth/auth.service.ts". `createdAt` is
  // the generation timestamp: imported notes are written once, by the job.
  generatedByAI Boolean    @default(false)
  sourcePath    String?
  importJob     ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  importJobId   String?

  @@index([userId, isArchived])
  @@index([importJobId])
}

model Project {
  id          String      @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String      @default("#6366f1")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  sourceRepo  String?
  notes       Note[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  snippets    Snippet[]
  tasks       Task[]
  importJobs  ImportJob[]

  @@index([userId])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  userId      String
  title       String
  description String?
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  assignee    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Cascade, not the default Restrict: deleting your account has to work for a
  // user who has tasks (see migration 20260912000000).
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Provenance (see Note) ──────────────────────────────────────────────────
  generatedByAI Boolean    @default(false)
  sourcePath    String?
  importJob     ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  importJobId   String?

  @@index([projectId, status])
  @@index([userId])
  @@index([importJobId])
}

model Snippet {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  code        String
  language    String   @default("plaintext")
  tags        String[]
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Provenance (see Note) ──────────────────────────────────────────────────
  generatedByAI Boolean    @default(false)
  sourcePath    String?
  importJob     ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  importJobId   String?

  @@index([userId])
  @@index([importJobId])
}

/// A persistent GitHub import. The row is created before any work happens and
/// updated as the import progresses, so the client can poll it (even after
/// navigating away or reloading) and so a crash or restart leaves an auditable
/// record instead of silently losing in-memory state.
model ImportJob {
  id               String          @id @default(cuid())
  userId           String
  projectId        String?
  repoOwner        String
  repoName         String
  repoFullName     String
  branch           String?
  status           ImportJobStatus @default(PENDING)
  // Which step the pipeline is on — drives the UI's progress checklist.
  stage            ImportStage     @default(QUEUED)
  // Human-readable copy owned by the backend, so wording can change without a
  // frontend deploy. Never used for logic (see `stage`).
  stageLabel       String          @default("Queued")
  progress         Int             @default(0)
  totalFiles       Int             @default(0)
  processedFiles   Int             @default(0)
  currentFile      String?
  totalBatches     Int             @default(0)
  completedBatches Int             @default(0)
  notesCreated     Int             @default(0)
  snippetsCreated  Int             @default(0)
  tasksCreated     Int             @default(0)
  filesAnalyzed    Int             @default(0)
  // Non-fatal issue worth showing the user (e.g. some batches failed to analyze).
  warning          String?
  // Safe, user-facing failure message. Never contains tokens, stack traces or
  // upstream response bodies — the full detail goes to the server log.
  error            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes    Note[]
  snippets Snippet[]
  tasks    Task[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

/// A linked sign-in provider. `accessToken`/`refreshToken` hold AES-256-GCM
/// ciphertext when OAUTH_ENCRYPTION_KEY is set (see TokenCryptoService); they
/// are decrypted only server-side, to call the provider API, and no endpoint
/// ever returns them.
model OAuthAccount {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  providerUid  String
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId, provider])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  DEVELOPER
  GUEST
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportStage {
  QUEUED
  CONNECTED
  READING
  ANALYZING
  SAVING
  COMPLETED
  FAILED
}
