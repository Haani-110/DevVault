# DevVault backend — local development defaults.
#
# Copy to `.env` and fill in what you actually use. Every variable here is read
# in exactly one place, `src/config/env.ts`, which also decides what happens
# when it is missing: the values with a default are optional locally, and the
# JWT secrets stop being optional once NODE_ENV=production.

# --- Core ---------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/devvault
PORT=4000

# Where the SPA lives: the target of OAuth and password-reset redirects, and an
# allowed CORS origin. Comma-separated if you have more than one.
FRONTEND_URL=http://localhost:5000
# Extra origins allowed to call the API from a browser, on top of FRONTEND_URL.
CORS_ALLOWED_ORIGINS=

# --- Secrets ------------------------------------------------------------------
# Generate each one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A deployment that boots on the development defaults refuses to start in
# production on purpose — see src/config/env.ts.
JWT_ACCESS_SECRET=devvault-access-secret-change-in-production
JWT_REFRESH_SECRET=devvault-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encrypts the GitHub/Google access tokens stored in OAuthAccount. The GitHub
# token can read private repositories, so this should be set anywhere the
# database is not yours alone. Format: 32 bytes of hex (64 characters).
# Unset = tokens are stored in plaintext (fine for a throwaway local database).
OAUTH_ENCRYPTION_KEY=

# --- OAuth providers ------------------------------------------------------------
# Both are optional; leaving a pair empty keeps the routes mounted but reports
# "not configured" instead of failing at boot.
# Google: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# GitHub: https://github.com/settings/developers → OAuth Apps.
# The callback URL must match this exactly. Scopes: `user:email` is needed to
# find the account, and `repo` is what lets the importer read private repos —
# drop it to `user:email public_repo` if you only want public ones.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
GITHUB_SCOPE=user:email repo

# --- Email (password reset) -----------------------------------------------------
# Optional. Without a key, reset links are logged to the console instead of
# emailed, which is all local development needs.
SENDGRID_API_KEY=
FROM_EMAIL=noreply@devvault.local

# --- AI-assisted GitHub import --------------------------------------------------
# Get a key (free tier, no card): https://console.groq.com/keys
# Without it the import routes answer 500 with code AI_NOT_CONFIGURED and
# everything else in the app keeps working.
GROQ_API_KEY=
# Optional override; defaults to llama-3.3-70b-versatile.
GROQ_MODEL=

# --- Limits ---------------------------------------------------------------------
# Requests per IP per window. The credential routes (login/register/reset) are
# stricter than this in code; this is the backstop for everything else.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Wall-clock ceiling for one background import job before it is failed.
IMPORT_TIMEOUT_MS=600000
